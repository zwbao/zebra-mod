#!/usr/bin/env python3
"""Run the zebra CLI from a checkout without installing it."""
import os
import shutil
import sys


def _configured_python():
    """The interpreter zebra-mod is configured to use (ZEBRA_PYTHON, set by the plugin for the
    session's shell), when this one is not it: `zebra` typed in Bash then runs under the same
    Python as the mod's own tools instead of whatever python3 comes first on PATH."""
    want = os.environ.get("ZEBRA_PYTHON")
    if not want or os.environ.get("ZEBRA_REEXEC"):
        return None
    path = shutil.which(want) or (want if os.path.isfile(want) and os.access(want, os.X_OK) else None)
    if not path or os.path.abspath(path) == os.path.abspath(sys.executable):
        return None
    return path


_py = _configured_python()
if _py:
    os.environ["ZEBRA_REEXEC"] = "1"  # once only
    try:
        os.execv(_py, [_py, os.path.realpath(__file__)] + sys.argv[1:])
    except OSError:
        pass  # not runnable: carry on with this interpreter

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from zebra.cli import main  # noqa: E402

raise SystemExit(main())
